# ===== claw-gallery 配置模板 =====
# 复制为 .env 后按需修改：cp .env.example .env
# 注意：已存在的系统环境变量优先级更高，.env 不会覆盖它们。

# ---- 网络 ----
# 出网代理；本机运行通常需要，云服务器直连则留空
CLAW_PROXY=http://127.0.0.1:10808
# 上游站点地址（一般留空：由门禁里填写的域名或最近抓取记录自动推导）
CLAW_API_ORIGIN=
# 本地代理对 HTTPS 做 MITM 导致证书报错时，可设为 1 关闭校验
CLAW_INSECURE_TLS=
# 自定义 User-Agent
CLAW_UA=

# ---- 立即下载模式（核心开关）----
# cache  = 先保存到服务器磁盘（download/），再读盘转发给浏览器；
#          同一个作品重复点击不再请求上游；适合磁盘充足的 VPS
# stream = 64KB 流式转发，不在服务器落盘；适合磁盘紧张的 VPS
CLAW_DOWNLOAD_MODE=cache

# ---- 服务监听 ----
# 部署到 VPS：改成 0.0.0.0 并在云厂商安全组放行端口（不要绑具体公网 IP）
CLAW_HOST=127.0.0.1
CLAW_PORT=8787

# ---- 抓取节奏 ----
# 列表页每页间隔（秒）；这是页面「页面间隔」输入框的默认值
CLAW_DELAY=0.1
# 页面间隔的允许范围（秒）：输入框的 min/max，也是后端最终夹取的范围。
# 注意 CLAW_DELAY 一定生效：下限实际取 min(CLAW_MIN_DELAY, CLAW_DELAY)
CLAW_MIN_DELAY=0.1
CLAW_MAX_DELAY=2
# 详情补全间隔（秒）
CLAW_DETAIL_DELAY=0.2
# 封面下载间隔（秒）
CLAW_COVER_DELAY=0.1
# 详情补全 / 保存封面 的默认开关（页面复选框的初始状态；1 开 0 关）
CLAW_ENRICH=1
CLAW_COVERS=1
# 请求超时（秒）与重试次数
CLAW_TIMEOUT=30
CLAW_RETRIES=3
# 单次抓取最多页数（页面「最多页数」输入框上限；填 0 表示不限）
CLAW_MAX_PAGES=200
# 增量抓取：同一 URL 再次抓取时只抓新增（遇到已收录条目即停）；设为 0 关闭
CLAW_INCREMENTAL=1
# 列表页满页条目数（明显少于该值时视为已到末页）
CLAW_PAGE_SIZE_HINT=5
# 门禁/页面里「列表页 URL」的预填值（留空则不预填）
CLAW_DEFAULT_URL=

# ---- 批量下载 ----
# 服务端下载队列并发数（同时下载的任务数）
CLAW_DOWNLOAD_CONCURRENCY=5

# 每个文件之间的间隔（秒），避免把上游/带宽打满
CLAW_DOWNLOAD_DELAY=1.0
# 下载文件保存目录（cache 模式也用它作为缓存目录）
CLAW_DOWNLOADS_DIR=

# ---- 数据与产物位置 ----
CLAW_DB=
CLAW_DATA_DIR=
CLAW_COVER_DIR=
# ---- 多用户 ----
# 登录会话有效期（小时）
CLAW_SESSION_TTL_HOURS=720
# 每个登录用户的独立 SQLite 目录；留空 = data/users/
CLAW_USER_DATA_DIR=

# ---- 存储模式 ----
# cloud（默认）：业务数据直接读写 Supabase，不落本地 SQLite；无同步操作，
#   注册/登录一律走云端；VPS 部署直接用默认
# local（本机离线 / 未配置 Supabase）：业务数据存本地 SQLite，
#   注册写云端（可选），「同步」按钮双向同步；支持本机代理抓取
CLAW_STORAGE_BACKEND=cloud

# ---- Supabase 云同步（可选）----
# 留空 project_ref 或 token 即纯本地模式；token 只放部署环境，禁止提交
# token 填【账号级 Personal Access Token】(PAT)：Supabase 没有「纯 HTTP +
# service role 执行 SQL」端点，传输层走 Management API（api.supabase.com），
# 只认 PAT。获取：https://supabase.com/dashboard/account/tokens
CLAW_SUPABASE_PROJECT_REF=
CLAW_SUPABASE_TOKEN=
# Management API 地址（一般无需修改）
CLAW_SUPABASE_API_URL=https://api.supabase.com
# 预留：若将来改用 psycopg 走 Postgres TCP 直连才用到（默认由 ref 推导）
CLAW_SUPABASE_DB_URL=
CLAW_SUPABASE_TIMEOUT=30
# 云端表名前缀
CLAW_SUPABASE_TABLE_PREFIX=claw_
# 单次同步最多读取/推送的行数
CLAW_SUPABASE_SYNC_MAX_ROWS=20000
