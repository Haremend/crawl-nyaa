# ===== claw-gallery 配置模板 =====
# 复制为 .env 后按需修改：cp .env.example .env
# 注意：已存在的系统环境变量优先级更高，.env 不会覆盖它们。

# ---- 网络 ----
# 出网代理；本机运行通常需要，云服务器直连则留空
CLAW_PROXY=http://127.0.0.1:10808
# 上游站点地址（一般留空：由门禁里填写的域名或最近抓取记录自动推导）
CLAW_API_ORIGIN=
# 本地代理对 HTTPS 做 MITM 导致证书报错时，可设为 1 关闭校验
CLAW_INSECURE_TLS=
# 自定义 User-Agent
CLAW_UA=

# ---- 立即下载模式（核心开关）----
# cache  = 先保存到服务器磁盘（download/），再读盘转发给浏览器；
#          同一个作品重复点击不再请求上游；适合磁盘充足的 VPS
# stream = 64KB 流式转发，不在服务器落盘；适合磁盘紧张的 VPS
CLAW_DOWNLOAD_MODE=stream

# ---- 服务监听 ----
# 部署到 VPS：改成 0.0.0.0 并在云厂商安全组放行端口（不要绑具体公网 IP）
CLAW_HOST=127.0.0.1
CLAW_PORT=8787

# ---- 抓取节奏 ----
# 列表页每页间隔（秒）
CLAW_DELAY=1.2
# 详情补全间隔（秒）
CLAW_DETAIL_DELAY=0.4
# 封面下载间隔（秒）
CLAW_COVER_DELAY=0.25
# 请求超时（秒）与重试次数
CLAW_TIMEOUT=30
CLAW_RETRIES=3
# 单次抓取最多页数
CLAW_MAX_PAGES=200
# 增量抓取：同一 URL 再次抓取时只抓新增（遇到已收录条目即停）；设为 0 关闭
CLAW_INCREMENTAL=1

# ---- 批量下载 ----
# 服务端下载队列并发数（同时下载的任务数）
CLAW_DOWNLOAD_CONCURRENCY=5

# 每个文件之间的间隔（秒），避免把上游/带宽打满
CLAW_DOWNLOAD_DELAY=1.0
# 下载文件保存目录（cache 模式也用它作为缓存目录）
CLAW_DOWNLOADS_DIR=

# ---- 数据与产物位置 ----
CLAW_DB=
CLAW_DATA_DIR=
CLAW_COVER_DIR=
# ---- 多用户 ----
# 登录会话有效期（小时）
CLAW_SESSION_TTL_HOURS=720
# 每个登录用户的独立 SQLite 目录；留空 = data/users/
CLAW_USER_DATA_DIR=

# ---- Supabase 云同步（可选）----
# 留空 project_ref 或 token 即纯本地模式；token 只放部署环境，禁止提交
CLAW_SUPABASE_PROJECT_REF=
CLAW_SUPABASE_TOKEN=
# Management API 地址，一般无需修改
CLAW_SUPABASE_API_URL=https://api.supabase.com
CLAW_SUPABASE_TIMEOUT=30
# 云端表名前缀
CLAW_SUPABASE_TABLE_PREFIX=claw_
# 单次同步最多读取/推送的行数
CLAW_SUPABASE_SYNC_MAX_ROWS=20000
